APP_ENV=development
DATABASE_URL=sqlite:///./mailmind.db
DEV_USER_EMAIL=developer@example.test
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/google/callback
GMAIL_REDIRECT_URI=http://127.0.0.1:8001/api/integrations/gmail/callback
CALENDAR_REDIRECT_URI=http://127.0.0.1:8001/api/integrations/calendar/callback
SESSION_SECRET=replace-this-development-secret-with-a-random-32-byte-value
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEY_ID=current
# Optional rotation key ring format: old-key-id:base64-key,older-key-id:base64-key
TOKEN_ENCRYPTION_KEY_PREVIOUS=
GMAIL_SYNC_MAX_MESSAGES=50
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_MAX_INPUT_CHARS=16000
AI_USER_REQUESTS_PER_MINUTE=12
FRONTEND_URL=http://127.0.0.1:5174
BACKEND_URL=http://127.0.0.1:8001
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
